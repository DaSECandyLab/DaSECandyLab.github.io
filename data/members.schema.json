{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candy Lab member registry",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "role",
      "enrollmentYear",
      "graduationYear"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "enum": [
          "advisor",
          "student"
        ]
      },
      "degree": {
        "enum": [
          "masters",
          "phd",
          null
        ]
      },
      "photo": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^assets/"
      },
      "enrollmentYear": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1900,
        "maximum": 2200
      },
      "graduationYear": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1900,
        "maximum": 2200
      },
      "publicationNames": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "publicationSources": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "orcid": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9X]{4}$"
          },
          "homepage": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      },
      "yearEvidence": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "inferred",
              "confirmed",
              "unknown",
              "not-applicable"
            ]
          },
          "source": {
            "type": "string"
          },
          "sourceCommit": {
            "type": "string"
          },
          "sourceYear": {
            "type": "integer"
          },
          "assumedDurationYears": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "inferred"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "source",
                "note"
              ]
            }
          }
        ]
      }
    }
  }
}
